# Copy to .env. Never commit real values.
# Generate the hash with:
# docker compose run --rm --no-deps backend python -m app.core.password_hash
ADMIN_PASSWORD_HASH=

# Production values are injected by Cloud Run / Secret Manager.
# 本機開發範例，請自行設定密碼
DATABASE_URL=postgresql+psycopg://cloudpulse:<YOUR_PASSWORD>@postgres:5432/cloudpulse
PUBLIC_BASE_URL=http://backend:8000
ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Optional host-port overrides. Container-to-container ports stay unchanged.
POSTGRES_PORT=5433
BACKEND_PORT=8001
FRONTEND_PORT=5174
